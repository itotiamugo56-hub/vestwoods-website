---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="mx-auto max-w-3xl text-center">
    <h1 class="text-4xl font-bold text-gray-900">About Vestwoods</h1>
    <p class="mt-4 text-xl text-gray-600">
      Leading provider of advanced energy storage solutions
    </p>
    <div class="mt-8 space-y-4 text-left text-gray-700">
      <p>Vestwoods specializes in lithium battery systems and hybrid inverters for residential, commercial, and utility-scale applications.</p>
      <p>Our products are certified to international standards including UL, CE, and IEC, ensuring safety and reliability for critical power applications.</p>
      <p>Contact our team to discuss your project requirements.</p>
    </div>
  </div>
</BaseLayout>