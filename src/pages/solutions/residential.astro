---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CertificationBadges from '../../components/ui/CertificationBadges.astro';
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="py-12 md:py-20">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-[#1f2937] mb-4">
        Residential Energy Storage
      </h1>
      <p class="text-xl text-[#4b5563] mb-8">
        Power your home with clean, reliable backup. Save money. Never worry about outages again.
      </p>
      <a href="/contact" class="btn-primary inline-block">
        Get Your Free Quote →
      </a>
    </div>
  </section>

  <!-- Problem Statement -->
  <section class="py-12 bg-[#f5f2eb] rounded-2xl my-8">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <div class="text-5xl mb-4">⚡</div>
      <h2 class="text-2xl font-bold text-[#1f2937] mb-4">Tired of rising electricity bills and power outages?</h2>
      <p class="text-[#4b5563] text-lg">
        You're not alone. Millions of homeowners are switching to battery storage to take control of their energy costs and keep the lights on during grid failures.
      </p>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-[#1f2937] text-center mb-12">How It Works</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-20 h-20 bg-[#2563eb]/10 rounded-full flex items-center justify-center text-3xl mx-auto mb-4">☀️</div>
          <h3 class="text-xl font-semibold text-[#1f2937] mb-2">1. Generate or Store</h3>
          <p class="text-[#4b5563]">Solar panels generate free electricity during the day. Or charge from the grid at off-peak rates.</p>
        </div>
        <div class="text-center">
          <div class="w-20 h-20 bg-[#2563eb]/10 rounded-full flex items-center justify-center text-3xl mx-auto mb-4">🔋</div>
          <h3 class="text-xl font-semibold text-[#1f2937] mb-2">2. Store Excess Energy</h3>
          <p class="text-[#4b5563]">Your Vestwoods battery captures unused energy instead of sending it back to the grid.</p>
        </div>
        <div class="text-center">
          <div class="w-20 h-20 bg-[#2563eb]/10 rounded-full flex items-center justify-center text-3xl mx-auto mb-4">🏠</div>
          <h3 class="text-xl font-semibold text-[#1f2937] mb-2">3. Use When Needed</h3>
          <p class="text-[#4b5563]">Power your home at night, during outages, or when electricity rates are highest.</p>
        </div>
      </div>
      <!-- System Diagram -->
      <div class="mt-12 p-8 bg-[#faf8f5] rounded-xl text-center text-[#4b5563] border-2 border-dashed border-[#e5e0d5]">
        📐 System Diagram – Solar panels → Hybrid Inverter → Battery Storage → Home Loads → Grid Export
      </div>
    </div>
  </section>

  <!-- Key Benefits -->
  <section class="py-12 bg-[#f5f2eb] rounded-2xl my-8">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-[#1f2937] text-center mb-12">Why Homeowners Choose Vestwoods</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="flex gap-3">
          <span class="text-green-600 text-xl">✓</span>
          <div><strong class="text-[#1f2937] block">Save up to 70% on electricity bills</strong> <span class="text-[#4b5563] text-sm">Based on typical residential usage patterns</span></div>
        </div>
        <div class="flex gap-3">
          <span class="text-green-600 text-xl">✓</span>
          <div><strong class="text-[#1f2937] block">24/7 backup during outages</strong> <span class="text-[#4b5563] text-sm">Automatic switchover in milliseconds</span></div>
        </div>
        <div class="flex gap-3">
          <span class="text-green-600 text-xl">✓</span>
          <div><strong class="text-[#1f2937] block">10-year warranty</strong> <span class="text-[#4b5563] text-sm">Industry-leading coverage for peace of mind</span></div>
        </div>
        <div class="flex gap-3">
          <span class="text-green-600 text-xl">✓</span>
          <div><strong class="text-[#1f2937] block">Reduce carbon footprint</strong> <span class="text-[#4b5563] text-sm">Typical system offsets 3.5 tons of CO₂ annually</span></div>
        </div>
        <div class="flex gap-3">
          <span class="text-green-600 text-xl">✓</span>
          <div><strong class="text-[#1f2937] block">Smart app monitoring</strong> <span class="text-[#4b5563] text-sm">Track production, consumption, and savings in real time</span></div>
        </div>
        <div class="flex gap-3">
          <span class="text-green-600 text-xl">✓</span>
          <div><strong class="text-[#1f2937] block">Local installer network</strong> <span class="text-[#4b5563] text-sm">Certified professionals in your area</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Typical Configuration -->
  <section class="py-12">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-[#1f2937] text-center mb-8">Recommended System</h2>
      <div class="bg-white border border-[#e5e0d5] rounded-2xl p-6 shadow-sm">
        <table class="w-full">
          <tr class="border-b border-[#e5e0d5]">
            <td class="py-3 font-semibold text-[#1f2937]">Battery</td>
            <td class="py-3 text-[#4b5563]">10kWh Lithium Battery (expandable to 20kWh+)</td>
          </tr>
          <tr class="border-b border-[#e5e0d5]">
            <td class="py-3 font-semibold text-[#1f2937]">Inverter</td>
            <td class="py-3 text-[#4b5563]">5kW Hybrid Inverter (supports solar + battery)</td>
          </tr>
          <tr class="border-b border-[#e5e0d5]">
            <td class="py-3 font-semibold text-[#1f2937]">Solar Compatible</td>
            <td class="py-3 text-[#4b5563]">Yes – works with existing or new solar panels</td>
          </tr>
        </table>
        <div class="mt-6 p-4 bg-[#2563eb]/10 rounded-lg text-center">
          <p class="text-[#1f2937]">🏠 <strong class="text-[#1f2937]">Covers typical home usage:</strong> 10-15 kWh per day, enough for essentials during outages (refrigerator, lights, phones, WiFi, medical devices)</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Estimated ROI -->
  <section class="py-12 bg-[#f5f2eb] rounded-2xl my-8">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl font-bold text-[#1f2937] mb-4">Estimated Return on Investment</h2>
      <div class="bg-white rounded-xl p-6 shadow-sm mb-6">
        <div class="text-5xl font-bold text-[#2563eb] mb-2">4-6 years</div>
        <p class="text-[#4b5563]">Typical payback period through bill savings</p>
        <div class="w-full bg-gray-200 rounded-full h-2 mt-4">
          <div class="bg-[#2563eb] h-2 rounded-full" style="width: 75%"></div>
        </div>
        <p class="text-sm text-gray-500 mt-2">System lasts 10+ years → 4-6 years of pure savings after payback</p>
      </div>
      <div class="bg-white rounded-xl p-6 shadow-sm">
        <h3 class="text-lg font-bold mb-3 text-[#1f2937]">💰 Savings Calculator</h3>
        <div class="space-y-3 text-left">
          <div class="flex justify-between">
            <span class="text-[#4b5563]">Average monthly electricity bill:</span>
            <span class="font-semibold text-[#1f2937]">$150</span>
          </div>
          <div class="flex justify-between text-green-600">
            <span>Estimated savings (60%):</span>
            <span class="font-semibold">$90/month</span>
          </div>
          <div class="flex justify-between text-green-700 font-bold">
            <span>Annual savings:</span>
            <span>$1,080/year</span>
          </div>
          <div class="w-full bg-gray-200 rounded-full h-2 mt-2">
            <div class="bg-[#2563eb] h-2 rounded-full" style="width: 60%"></div>
          </div>
          <p class="text-xs text-gray-500 text-center mt-2">*Based on average utility rates. Your savings may vary.</p>
        </div>
      </div>
      <p class="text-sm text-gray-500 mt-4">*Local incentives may reduce payback period. Contact us for a personalized assessment.</p>
    </div>
  </section>

  <!-- Certifications -->
  <section class="py-12">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-semibold text-[#1f2937] mb-6">Safety & Compliance</h2>
      <CertificationBadges />
      <p class="text-sm text-[#4b5563] mt-4">All Vestwoods products meet or exceed international safety standards</p>
    </div>
  </section>

  <!-- Reference Project -->
  <section class="py-12 bg-[#f5f2eb] rounded-2xl my-8">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-2xl font-bold text-[#1f2937] text-center mb-8">Real Customer, Real Results</h2>
      <div class="bg-white rounded-xl p-6 shadow-sm">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-16 h-16 rounded-full bg-[#2563eb] flex items-center justify-center text-white font-bold text-xl">MO</div>
          <div>
            <div class="font-semibold text-[#1f2937]">Michael Okonkwo</div>
            <div class="text-sm text-[#4b5563]">Lagos, Nigeria</div>
          </div>
        </div>
        <p class="text-[#4b5563] italic mb-4">
          "After three grid outages last month, our Vestwoods battery kept the lights on every time. We've cut diesel generator usage by 80%. Best investment for our home."
        </p>
        <div class="grid grid-cols-2 gap-4 text-center text-sm">
          <div><span class="font-bold text-[#2563eb]">65%</span><br /><span class="text-[#4b5563]">reduction in bills</span></div>
          <div><span class="font-bold text-[#2563eb]">7+</span><br /><span class="text-[#4b5563]">outages survived</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="py-12">
    <div class="max-w-4xl mx-auto px-6">
      <div class="bg-[#1f2937] rounded-2xl p-6">
        <h3 class="text-xl font-bold mb-4 text-center" style="color: white !important;">What's Included</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
          <div>
            <div class="text-2xl mb-1">🔋</div>
            <div class="font-semibold text-sm" style="color: white !important;">10kWh Battery</div>
            <div class="text-xs" style="color: rgba(255, 255, 255, 0.7) !important;">Expandable to 20kWh</div>
          </div>
          <div>
            <div class="text-2xl mb-1">⚡</div>
            <div class="font-semibold text-sm" style="color: white !important;">5kW Inverter</div>
            <div class="text-xs" style="color: rgba(255, 255, 255, 0.7) !important;">Hybrid, bi-directional</div>
          </div>
          <div>
            <div class="text-2xl mb-1">📱</div>
            <div class="font-semibold text-sm" style="color: white !important;">App Monitoring</div>
            <div class="text-xs" style="color: rgba(255, 255, 255, 0.7) !important;">Real-time insights</div>
          </div>
          <div>
            <div class="text-2xl mb-1">🛡️</div>
            <div class="font-semibold text-sm" style="color: white !important;">10-Year Warranty</div>
            <div class="text-xs" style="color: rgba(255, 255, 255, 0.7) !important;">Peace of mind</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-[#1f2937] text-center mb-8">Frequently Asked Questions</h2>
      <div class="space-y-3">
        <details class="border border-[#e5e0d5] rounded-lg p-4 bg-white">
          <summary class="font-semibold text-lg text-[#1f2937] cursor-pointer">How long does installation take?</summary>
          <p class="text-[#4b5563] mt-2">Typical residential installation takes 1-2 days after site assessment.</p>
        </details>
        <details class="border border-[#e5e0d5] rounded-lg p-4 bg-white">
          <summary class="font-semibold text-lg text-[#1f2937] cursor-pointer">Will it work during a power outage?</summary>
          <p class="text-[#4b5563] mt-2">Yes – automatic islanding mode keeps your home powered when the grid goes down.</p>
        </details>
        <details class="border border-[#e5e0d5] rounded-lg p-4 bg-white">
          <summary class="font-semibold text-lg text-[#1f2937] cursor-pointer">What maintenance is required?</summary>
          <p class="text-[#4b5563] mt-2">Virtually none. The system self-manages and provides remote alerts if any issue arises.</p>
        </details>
        <details class="border border-[#e5e0d5] rounded-lg p-4 bg-white">
          <summary class="font-semibold text-lg text-[#1f2937] cursor-pointer">Are there tax credits available?</summary>
          <p class="text-[#4b5563] mt-2">Many regions offer incentives. Contact us for details specific to your location.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 bg-[#2563eb] rounded-2xl my-8 text-center">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-3xl font-bold mb-4" style="color: white !important;">Ready to take control of your energy?</h2>
      <p class="mb-8" style="color: rgba(255, 255, 255, 0.9) !important;">Get a custom quote for your home – no obligation, free consultation.</p>
      <a href="/contact?product=residential" class="bg-white text-[#2563eb] px-8 py-3 rounded-full font-semibold hover:bg-gray-100 transition-all inline-block">
        Request Your Free Quote →
      </a>
    </div>
  </section>
</BaseLayout>