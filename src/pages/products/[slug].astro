---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import productsData from '../../data/products.json';

export async function getStaticPaths() {
  const products = productsData.products;
  return products.map(product => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props;

if (!product) {
  return Astro.redirect("/404");
}

const specRows = [
  { label: "Capacity", value: product.specs.capacity_kWh ? `${product.specs.capacity_kWh} kWh` : "N/A", icon: "🔋" },
  { label: "Power", value: `${product.specs.power_kW} kW`, icon: "⚡" },
  { label: "Voltage", value: product.specs.voltage_V ? `${product.specs.voltage_V} V` : "N/A", icon: "⎍" },
  { label: "Cycle Life", value: product.specs.cycles ? `${product.specs.cycles.toLocaleString()} cycles` : "N/A", icon: "🔄" },
  { label: "Chemistry", value: product.specs.chemistry || "N/A", icon: "🧪" },
  { label: "Round-trip Efficiency", value: product.specs.efficiency || "N/A", icon: "📊" },
  { label: "Dimensions", value: product.specs.dimensions_mm || "N/A", icon: "📏" },
  { label: "Weight", value: product.specs.weight_kg ? `${product.specs.weight_kg} kg` : "N/A", icon: "⚖️" },
];
---

<BaseLayout>
  <div class="grid gap-8 lg:grid-cols-2">
    {/* Image Section */}
    <div class="bg-[#faf8f5] rounded-2xl p-8 border border-[#e5e0d5]">
      <img 
        src={product.imageUrl} 
        alt={product.name}
        class="mx-auto max-h-96 w-auto object-contain"
        onerror="this.src='https://placehold.co/400x400?text=No+Image'"
      />
    </div>
    
    {/* Info Section */}
    <div>
      <div class="mb-2">
        <span class="inline-block px-3 py-1 bg-[#2c7a8c]/10 text-[#2c7a8c] text-sm rounded-full capitalize">
          {product.category}
        </span>
      </div>
      <h1 class="text-3xl font-bold text-[#1e2a3e]">{product.name}</h1>
      
      <div class="mt-6 flex flex-col sm:flex-row gap-3">
        <a 
          href="/contact" 
          class="btn-primary text-center"
        >
          Request Quote
        </a>
        <button 
          id="compare-btn"
          data-compare-id={product.id}
          class="btn-secondary"
        >
          Add to Compare
        </button>
        <button 
          id="download-pdf-btn"
          data-product={JSON.stringify(product)}
          class="btn-secondary"
        >
          📄 Download Spec Sheet
        </button>
      </div>
      
      {/* Quick Spec Highlights */}
      <div class="mt-8 grid grid-cols-2 gap-3">
        {specRows.slice(0, 4).map(row => (
          <div class="flex items-center gap-2 text-sm">
            <span class="text-lg">{row.icon}</span>
            <div>
              <div class="text-gray-500 text-xs">{row.label}</div>
              <div class="font-medium text-[#1e2a3e]">{row.value}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
  
  {/* Full Specs Table - Modern Style */}
  <div class="mt-12">
    <h2 class="text-2xl font-bold text-[#1e2a3e] mb-6 flex items-center gap-2">
      <span class="text-2xl">📋</span>
      Technical Specifications
    </h2>
    <div class="overflow-hidden rounded-xl border border-[#e5e0d5]">
      <table class="w-full">
        <tbody>
          {specRows.map((row, idx) => (
            <tr class={`${idx % 2 === 0 ? 'bg-[#faf8f5]' : 'bg-white'} border-b border-[#e5e0d5] last:border-0`}>
              <th class="w-1/3 px-6 py-4 text-left font-semibold text-[#1e2a3e]">
                <div class="flex items-center gap-2">
                  <span class="text-lg">{row.icon}</span>
                  <span>{row.label}</span>
                </div>
              </th>
              <td class="px-6 py-4 text-gray-700">
                {row.value}
              </td>
            </tr>
          ))}
        </tbody>
       </table>
    </div>
  </div>
  
  {/* Certifications Section */}
  {product.certifications && product.certifications.length > 0 && (
    <div class="mt-8">
      <h3 class="text-lg font-semibold text-[#1e2a3e] flex items-center gap-2">
        <span class="text-lg">✅</span>
        Certifications & Compliance
      </h3>
      <div class="mt-3 flex flex-wrap gap-2">
        {product.certifications.map(cert => (
          <span class="rounded-full bg-green-50 text-green-700 px-3 py-1 text-sm border border-green-200">
            {cert}
          </span>
        ))}
      </div>
    </div>
  )}
  
  {/* Related Products Suggestion */}
  <div class="mt-12 pt-8 border-t border-[#e5e0d5]">
    <h3 class="text-lg font-semibold text-[#1e2a3e] mb-4">You might also like</h3>
    <div class="flex gap-4 flex-wrap">
      <a href="/products" class="text-[#2c7a8c] hover:underline text-sm">
        ← Back to all products
      </a>
    </div>
  </div>
</BaseLayout>

<script>
  // Helper function to prevent XSS
  function escapeHtml(str) {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // Compare button handler
  const compareBtn = document.getElementById('compare-btn');
  if (compareBtn) {
    compareBtn.addEventListener('click', () => {
      const productId = compareBtn.getAttribute('data-compare-id');
      const params = new URLSearchParams(window.location.search);
      let ids = params.get('ids') ? params.get('ids').split(',') : [];
      
      if (!ids.includes(productId)) {
        if (ids.length >= 4) {
          alert('Maximum 4 products can be compared');
          return;
        }
        ids.push(productId);
      }
      
      params.set('ids', ids.join(','));
      window.location.href = `/products/compare?${params.toString()}`;
    });
  }
  
  // PDF download handler
  const downloadBtn = document.getElementById('download-pdf-btn');
  if (downloadBtn) {
    downloadBtn.addEventListener('click', async () => {
      const productAttr = downloadBtn.getAttribute('data-product');
      if (!productAttr) return;
      
      let product;
      try {
        product = JSON.parse(productAttr);
      } catch (e) {
        console.error('Failed to parse product data', e);
        alert('Error generating spec sheet');
        return;
      }
      
      const html = `
        <!DOCTYPE html>
        <html>
        <head>
          <meta charset="UTF-8">
          <title>${escapeHtml(product.name)} - Spec Sheet</title>
          <style>
            body { font-family: Arial, sans-serif; margin: 40px; line-height: 1.6; }
            h1 { color: #1e2a3e; border-bottom: 2px solid #2c7a8c; padding-bottom: 10px; }
            .specs { width: 100%; border-collapse: collapse; margin: 20px 0; }
            .specs td, .specs th { border: 1px solid #ddd; padding: 12px; text-align: left; }
            .specs th { background: #f5f2eb; width: 30%; }
            .cert-badge { display: inline-block; background: #10b981; color: white; padding: 4px 12px; border-radius: 20px; margin: 4px; font-size: 12px; }
            .footer { margin-top: 40px; font-size: 12px; color: #6b7280; text-align: center; }
          </style>
        </head>
        <body>
          <h1>${escapeHtml(product.name)}</h1>
          <p>Technical Specifications - ${new Date().toISOString().split('T')[0]}</p>
          <table class="specs">
            <tr><th>Specification</th><th>Value</th></tr>
            ${product.specs.capacity_kWh ? `<tr><th>Capacity</th><td>${escapeHtml(String(product.specs.capacity_kWh))} kWh</td>` : ''}
            ${product.specs.power_kW ? `<tr><th>Power</th><td>${escapeHtml(String(product.specs.power_kW))} kW</td>` : ''}
            ${product.specs.voltage_V ? `<tr><th>Voltage</th><td>${escapeHtml(String(product.specs.voltage_V))} V</td>` : ''}
            ${product.specs.cycles ? `<tr><th>Cycle Life</th><td>${escapeHtml(String(product.specs.cycles))} cycles</td>` : ''}
            ${product.specs.chemistry ? `<tr><th>Chemistry</th><td>${escapeHtml(product.specs.chemistry)}</td>` : ''}
            ${product.specs.efficiency ? `<tr><th>Efficiency</th><td>${escapeHtml(product.specs.efficiency)}</td>` : ''}
            ${product.specs.dimensions_mm ? `<tr><th>Dimensions</th><td>${escapeHtml(product.specs.dimensions_mm)} mm</td>` : ''}
            ${product.specs.weight_kg ? `<tr><th>Weight</th><td>${escapeHtml(String(product.specs.weight_kg))} kg</td>` : ''}
          </table>
          <div><strong>Certifications:</strong><br>${(product.certifications || []).map(c => `<span class="cert-badge">${escapeHtml(c)}</span>`).join('')}</div>
          <div class="footer">Vestwoods Energy Storage Solutions - sales@vestwoods.com</div>
        </body>
        </html>
      `;
      
      const blob = new Blob([html], { type: 'text/html' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${product.slug}-spec-sheet.html`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  }
</script>