---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/products/ProductCard.astro';
import productsData from '../../data/products.json';

const products = productsData.products || [];
---

<BaseLayout>
  <div class="mb-8 text-center md:text-left">
    <h1 class="text-3xl md:text-4xl font-bold text-[#1e2a3e]">All Products</h1>
    <p class="mt-2 text-gray-600">Energy storage solutions for every application</p>
  </div>
  
  {products.length === 0 ? (
    <div class="rounded-lg bg-yellow-50 p-4 text-yellow-800">
      No products found. Check that src/data/products.json exists and has a "products" array.
    </div>
  ) : (
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {products.map(product => (
        <ProductCard product={product} />
      ))}
    </div>
  )}
</BaseLayout>