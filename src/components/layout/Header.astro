---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/products', label: 'Products' },
  { href: '/solutions/residential', label: 'Solutions', hasDropdown: true },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const solutionItems = [
  { href: '/solutions/residential', label: '🏠 Residential' },
  { href: '/solutions/commercial', label: '🏭 Commercial' },
  { href: '/solutions/utility', label: '⚡ Utility & Grid-Scale' },
];
---

<header class="scroll-depth border-b border-[#e5e0d5] bg-[#faf8f5] sticky top-0 z-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="flex items-center">
        <a href="/" class="text-xl font-bold text-[#1e2a3e]">Vestwoods</a>
      </div>
      
      <nav class="hidden md:block">
        <ul class="flex space-x-8">
          {navItems.map((item) => (
            <li class="relative group">
              <a 
                href={item.href} 
                class="text-[#2c3e4e] hover:text-[#1e2a3e] transition-colors inline-flex items-center gap-1"
              >
                {item.label}
                {item.hasDropdown && (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                )}
              </a>
              
              {item.hasDropdown && (
                <div class="absolute left-0 mt-2 w-56 rounded-lg shadow-lg bg-[#faf8f5] border border-[#e5e0d5] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                  <div class="py-2">
                    {solutionItems.map((solution) => (
                      <a
                        href={solution.href}
                        class="block px-4 py-2 text-[#2c3e4e] hover:bg-[#f0ede5] hover:text-[#1e2a3e] transition-colors"
                      >
                        {solution.label}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </li>
          ))}
        </ul>
      </nav>
      
      <div class="md:hidden">
        <button 
          id="mobile-menu-button"
          class="rounded-lg p-2 text-[#2c3e4e] hover:bg-[#f0ede5]"
          aria-label="Menu"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
      
      <a 
        href="/contact" 
        class="btn-primary hidden md:inline-block"
      >
        Request Quote
      </a>
    </div>
    
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <ul class="space-y-2">
        {navItems.map((item) => (
          <li>
            <a 
              href={item.href} 
              class="block rounded-lg px-3 py-2 text-[#2c3e4e] hover:bg-[#f0ede5]"
            >
              {item.label}
            </a>
            {item.hasDropdown && (
              <div class="ml-4 mt-1 space-y-1 border-l-2 border-[#e5e0d5] pl-3">
                {solutionItems.map((solution) => (
                  <a
                    href={solution.href}
                    class="block rounded-lg px-3 py-2 text-sm text-[#6b7280] hover:bg-[#f0ede5]"
                  >
                    {solution.label}
                  </a>
                ))}
              </div>
            )}
          </li>
        ))}
        <li>
          <a 
            href="/contact" 
            class="btn-primary block text-center"
          >
            Request Quote
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  (function() {
    var menuButton = document.getElementById('mobile-menu-button');
    var mobileMenu = document.getElementById('mobile-menu');
    
    if (menuButton && mobileMenu) {
      menuButton.addEventListener('click', function() {
        mobileMenu.classList.toggle('hidden');
      });
    }
  })();
</script>