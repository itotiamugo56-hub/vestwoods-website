---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/products', label: 'Products' },
  { href: '/solutions/residential', label: 'Solutions', hasDropdown: true },
  { href: '/contact', label: 'Contact' },
];

const solutionItems = [
  { href: '/solutions/residential', label: '🏠 Residential' },
  { href: '/solutions/commercial', label: '🏭 Commercial' },
  { href: '/solutions/utility', label: '⚡ Utility & Grid-Scale' },
];
---

<header class="sticky top-0 z-50 bg-[#2563eb] shadow-md">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="flex items-center">
        <a href="/" class="text-xl font-bold text-white hover:text-white/80 transition-colors" style="color: white !important;">
          Vestwoods
        </a>
      </div>
      
      <nav class="hidden md:block">
        <ul class="flex space-x-8">
          {navItems.map((item) => (
            <li class="relative group">
              <a 
                href={item.href} 
                class="text-white hover:text-white/80 transition-colors inline-flex items-center gap-1 font-medium"
                style="color: white !important;"
              >
                {item.label}
                {item.hasDropdown && (
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                )}
              </a>
              
              {item.hasDropdown && (
                <div class="absolute left-0 mt-2 w-56 rounded-xl shadow-lg bg-white border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                  <div class="py-2">
                    {solutionItems.map((solution) => (
                      <a
                        href={solution.href}
                        class="block px-4 py-2 text-gray-700 hover:bg-gray-50 hover:text-[#2563eb] transition-colors"
                      >
                        {solution.label}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </li>
          ))}
        </ul>
      </nav>
      
      <div class="md:hidden">
        <button 
          id="mobile-menu-button"
          class="rounded-lg p-2 text-white hover:text-white/80 hover:bg-white/10"
          aria-label="Menu"
        >
          <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
      
      <a 
        href="/contact" 
        class="hidden md:inline-block bg-white text-[#2563eb] px-5 py-2 rounded-full font-semibold hover:bg-gray-100 transition-all shadow-md hover:shadow-lg"
        style="color: #2563eb !important;"
      >
        Request Quote
      </a>
    </div>
    
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <ul class="space-y-2">
        {navItems.map((item) => (
          <li>
            <a 
              href={item.href} 
              class="block rounded-lg px-3 py-2 text-white hover:text-white/80 hover:bg-white/10"
              style="color: white !important;"
            >
              {item.label}
            </a>
            {item.hasDropdown && (
              <div class="ml-4 mt-1 space-y-1 border-l-2 border-white/20 pl-3">
                {solutionItems.map((solution) => (
                  <a
                    href={solution.href}
                    class="block rounded-lg px-3 py-2 text-sm text-white/70 hover:text-white hover:bg-white/10"
                    style="color: rgba(255,255,255,0.7) !important;"
                  >
                    {solution.label}
                  </a>
                ))}
              </div>
            )}
          </li>
        ))}
        <li>
          <a 
            href="/contact" 
            class="block bg-white text-[#2563eb] px-3 py-2 rounded-lg text-center font-semibold"
            style="color: #2563eb !important;"
          >
            Request Quote
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  (function() {
    var menuButton = document.getElementById('mobile-menu-button');
    var mobileMenu = document.getElementById('mobile-menu');
    
    if (menuButton && mobileMenu) {
      menuButton.addEventListener('click', function() {
        mobileMenu.classList.toggle('hidden');
      });
    }
  })();
</script>