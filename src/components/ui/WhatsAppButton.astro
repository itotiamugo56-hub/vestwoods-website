---
// Replace with actual Vestwoods WhatsApp number (include country code, no plus or spaces)
// Example: 1234567890 (for +1 234 567 890)
const whatsappNumber = '1234567890';
const defaultMessage = 'Hello Vestwoods, I\'m interested in your energy storage solutions.';
const encodedMessage = encodeURIComponent(defaultMessage);
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;
---

<a
  href={whatsappLink}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 bg-[#25D366] rounded-full shadow-lg hover:scale-110 transition-transform duration-200 group"
  aria-label="Chat on WhatsApp"
>
  <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.967-.94 1.165-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.614-.916-2.21-.242-.579-.487-.5-.669-.51-.173-.01-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.298-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12 2C6.48 2 2 6.48 2 12c0 1.892.521 3.664 1.426 5.191L2 22l4.809-1.426A9.959 9.959 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2z"/>
  </svg>
  
  <!-- Tooltip on hover -->
  <span class="absolute right-16 bg-gray-800 text-white text-sm px-3 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
    Chat with us on WhatsApp
  </span>
</a>