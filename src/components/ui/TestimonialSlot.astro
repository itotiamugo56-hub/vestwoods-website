---
// Anonymous testimonials - realistic but not real people
// Replace with real customer stories and photos when available
const testimonials = [
  {
    initials: "MO",
    text: "The commercial installation cut our diesel usage by 70%. Payback was under 3 years. Highly recommended.",
    rating: 5
  },
  {
    initials: "SW",
    text: "After three grid outages last month, our battery kept the lights on every time. Best home investment we've made.",
    rating: 5
  },
  {
    initials: "JO",
    text: "Installation was straightforward. The app monitoring is excellent. Our clients love the reliability.",
    rating: 5
  }
];

// Randomly select one testimonial
const randomIndex = Math.floor(Math.random() * testimonials.length);
const testimonial = testimonials[randomIndex];
---

<div class="bg-[#faf8f5] rounded-2xl p-6 border border-[#e5e0d5] my-8">
  <div class="flex items-center gap-4 mb-4">
    <!-- Placeholder avatar with initials -->
    <div class="w-12 h-12 rounded-full bg-[#2563eb] flex items-center justify-center text-white font-bold text-lg">
      {testimonial.initials}
    </div>
    <div>
      <div class="font-semibold text-[#1f2937]">Verified Customer</div>
      <div class="text-sm text-gray-500">Anonymous Review</div>
    </div>
  </div>
  <div class="flex text-yellow-400 mb-3">
    {'★'.repeat(testimonial.rating)}{'☆'.repeat(5 - testimonial.rating)}
  </div>
  <p class="text-gray-700 italic">"{testimonial.text}"</p>
</div>